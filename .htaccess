
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lindungi file sensitif
    <FilesMatch "^(\.env|\.gitignore|Dockerfile|README\.md|vercel\.json|router\.php)$">
        Require all denied
    </FilesMatch>

    # Blokir akses langsung ke file internal
    RewriteRule ^(sql|api/_app)(/|$) - [F,L,NC]

    # Layani aset CSS, JavaScript, dan gambar
    RewriteRule ^css/(.*)$ public/css/$1 [L,NC]
    RewriteRule ^js/(.*)$ public/js/$1 [L,NC]
    RewriteRule ^img/(.*)$ public/img/$1 [L,NC]

    # Jika file atau folder tersedia, layani langsung
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Arahkan URL aplikasi ke router PHP
    RewriteRule ^ api/index.php [QSA,L]
</IfModule>
